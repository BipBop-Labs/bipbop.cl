# Webhook de Discord usado para reenviar postulaciones recibidas antes del
# cierre. /admin sigue permitiendo reintentar entregas fallidas.
DISCORD_WEBHOOK_URL=

# Dónde vive la base SQLite con las postulaciones, sesiones históricas y
# entrevistas. En Docker apunta a un volumen.
DATA_DIR=./data

# Llave del panel en /admin, donde se ven las postulaciones y se reenvían las
# que no llegaron a Discord. Sin esto el panel queda cerrado, no abierto.
# Genera una con:  openssl rand -base64 32
ADMIN_KEY=
