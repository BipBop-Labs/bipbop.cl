# Webhook de Discord al que se envía cada postulación con el CV adjunto.
# Es obligatorio: sin esto el formulario de /postular responde 502.
DISCORD_WEBHOOK_URL=

# Dónde se guarda el registro de postulaciones (applications.jsonl), usado para
# deduplicar por correo. El CV nunca se guarda aquí: pasa por una carpeta
# temporal, se sube a Discord y la temporal se borra.
# En Docker/Coolify apunta a un volumen persistente (ej. /data).
DATA_DIR=./data
