# Webhook de Discord al que llega cada postulación con el CV adjunto. Es la
# fuente de verdad de las postulaciones. Obligatorio: sin esto /postular
# responde 502.
DISCORD_WEBHOOK_URL=

# Dónde vive la base SQLite: sesiones de la terminal a medio llenar y el
# registro de qué correos ya postularon. En Docker apunta a un volumen.
DATA_DIR=./data
